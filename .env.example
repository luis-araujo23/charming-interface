# PostgreSQL connection string used by server routes
# Example:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/diary_db
DATABASE_URL=

# Session signing secret (minimum 32 random chars)
AUTH_SESSION_SECRET=

# Supabase storage credentials for backend photo uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=diary-photos
