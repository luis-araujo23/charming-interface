# =============================================================================
# Kitty web — environment variables
# Local: copy values into the REPO ROOT file `../.env` (vite loads envDir: "..")
# Vercel: Project Settings → Environment Variables (Root Directory = `web`)
# =============================================================================

# Session signing secret (REQUIRED in production, min 32 random chars).
# Generate: openssl rand -base64 48
AUTH_SESSION_SECRET=

# Public app URL used in email confirmation redirects.
# Local: http://localhost:8080
# Vercel production: https://tu-proyecto.vercel.app  (or your custom domain)
# Also add `${APP_URL}/auth/confirmed` in Supabase → Authentication → URL Configuration.
APP_URL=http://localhost:8080

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=diary-photos

# Resend — REQUIRED for confirmation emails that actually arrive.
# Supabase free SMTP often never delivers. Create an account at https://resend.com
# 1) API Keys → Create API Key → paste here
# 2) Domains → verify your domain (needed to email ANY address, e.g. Gmail)
#    Until then, onboarding@resend.dev can only send to YOUR Resend account email.
RESEND_API_KEY=
# Optional. Default: Kitty <onboarding@resend.dev>
# After verifying a domain: Kitty <noreply@tudominio.com>
EMAIL_FROM=
