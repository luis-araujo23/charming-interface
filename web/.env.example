# =============================================================================
# Kitty web — environment variables
# Local: copy values into the REPO ROOT file `../.env` (vite loads envDir: "..")
# Vercel: Project Settings → Environment Variables (Root Directory = `web`)
# =============================================================================

AUTH_SESSION_SECRET=
APP_URL=http://localhost:8080

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=diary-photos

# -----------------------------------------------------------------------------
# EMAIL (required for verification that actually arrives)
# Option A — SMTP / Gmail (works with ANY recipient email TODAY):
#   1) Google Account → Security → 2-Step Verification ON
#   2) App passwords → create one for "Mail"
#   3) Put that 16-char password in SMTP_PASS (not your normal Gmail password)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu@gmail.com
SMTP_PASS=
EMAIL_FROM=Kitty <tu@gmail.com>

# Option B — Resend (best for worldwide scale):
#   Requires a VERIFIED DOMAIN in resend.com/domains
#   Without a domain, Resend cannot email arbitrary Gmail/Outlook users.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Kitty <noreply@tudominio.com>
