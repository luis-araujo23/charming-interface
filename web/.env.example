# =============================================================================
# Kitty web — environment variables
# Local: copy values into the REPO ROOT file `../.env` (vite loads envDir: "..")
# Vercel: Project Settings → Environment Variables (Root Directory = `web`)
# =============================================================================

# Session signing secret (REQUIRED in production, min 32 random chars).
# Generate: openssl rand -base64 48
AUTH_SESSION_SECRET=

# Public app URL used in email confirmation redirects.
# Local: http://localhost:8080
# Vercel production: https://tu-proyecto.vercel.app  (or your custom domain)
# Also add `${APP_URL}/auth/confirmed` in Supabase → Authentication → URL Configuration.
APP_URL=http://localhost:8080

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required to SEND signup confirmation emails (admin.createUser does not send mail).
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=diary-photos
